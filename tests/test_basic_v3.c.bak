#include <stdio.h>
#include <stdlib.h>
#include <rbcglob/rbcglob.h>

int main() {
    // We want to test that base="." results in "file.txt", not "./file.txt"
    rbcglob_compiled_glob_t *pat = rbcglob_compile_glob("file.txt", 0);
    if (!pat) {
        fprintf(stderr, "Compile failed\n");
        return 1;
    }

    size_t count = 0;
    char **results = NULL;
    // passing "." as base
    bool ok = rbcglob_dirglob_compiled(pat, ".", false, &results, &count, NULL);
    
    if (!ok) {
        printf("Error running glob\n");
    } else {
        printf("Count: %zu\n", count);
        for (size_t i = 0; i < count; i++) {
            printf("Result %zu: %s\n", i, results[i]);
        }
        rbcglob_free(results, count, NULL);
    }
    rbcglob_compiled_glob_free(pat);
    return 0;
}
